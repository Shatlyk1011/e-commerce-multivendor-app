# ──────────────────────────────────────────────────────────────────────────────
# Root .env.example — copy to .env and fill in values
# Used by Docker Compose for all services
# ──────────────────────────────────────────────────────────────────────────────

# Domain (used by Caddy for SSL and CORS)
DOMAIN=yourdomain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=medusa_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# No password needed for internal Redis; add one if you expose it
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_BUCKET=medusa-media
# Browser-visible bucket URL. In production this is typically
# https://files.yourdomain.com/medusa-media.
MINIO_PUBLIC_URL=http://localhost:9010/medusa-media

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change_me_master_key_minimum_32_characters
# Public (search-only) key — generate via Meilisearch API after first boot
MEILI_PUBLIC_KEY=change_me_public_search_key

# ── Medusa Backend ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_minimum_32_characters
COOKIE_SECRET=change_me_cookie_secret_minimum_32_chars
# Used only by the storefront server to derive the internal emailpass password
# for phone-authenticated customers. Generate a unique value of 32+ characters.
PHONE_AUTH_PASSWORD_SECRET=change_me_phone_auth_password_secret_minimum_32_chars
MEDUSA_BACKEND_URL=https://api.yourdomain.com

# ── Stripe (only external service) ───────────────────────────────────────────
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
