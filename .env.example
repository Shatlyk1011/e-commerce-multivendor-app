# Local Docker dependencies. Copy to .env (never commit actual credentials).
# Generate each secret independently, e.g. openssl rand -hex 32.
# Use hex for POSTGRES_PASSWORD so it is safe in DATABASE_URL without encoding.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace_with_random_hex
POSTGRES_DB=medusa_db
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace_with_random_hex
MINIO_BUCKET=medusa-media
MINIO_PUBLIC_URL=http://localhost:9010/medusa-media
MEILI_MASTER_KEY=replace_with_at_least_32_random_characters
JWT_SECRET=replace_with_at_least_32_random_characters
COOKIE_SECRET=replace_with_at_least_32_random_characters

# Copy from Admin > Settings > Publishable API Keys AFTER migrations.
# This is a public Store API key, never an admin token or Meilisearch master key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
