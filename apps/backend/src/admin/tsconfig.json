{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Module paths */
    "paths": {
      "@medusajs/js-sdk": [
        "../../node_modules/@medusajs/js-sdk/dist/index.d.ts"
      ],
      "@medusajs/icons": ["../../node_modules/@medusajs/icons/dist/index.d.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".", "../../.medusa/types/plugin-augmentations.d.ts"]
}
