# ──────────────────────────────────────────────────────────────────────────────
# apps/backend/.env.template — copy to .env and fill in values
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medusa:replace_with_random_hex@localhost:5433/medusa_db
# Docker Compose: postgresql://medusa:${POSTGRES_PASSWORD}@postgres:5432/medusa_db

# ── CORS ─────────────────────────────────────────────────────────────────────
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# ── Secrets ───────────────────────────────────────────────────────────────────
JWT_SECRET=supersecret_change_me_32_chars_min
COOKIE_SECRET=supersecret_change_me_32_chars_min

# ── MinIO (S3-compatible file storage) ────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9010
# Docker Compose (inside the Medusa container): http://minio:9000
MINIO_ACCESS_KEY=minio_admin
# Must match MINIO_ROOT_PASSWORD in the root .env file.
MINIO_SECRET_KEY=replace_with_random_hex
MINIO_BUCKET=medusa-media
MINIO_PUBLIC_URL=http://localhost:9010/medusa-media

# Provisioned only: search indexing is not integrated yet.
# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
# Docker Compose: http://meilisearch:7700
MEILISEARCH_API_KEY=change_me_master_key_minimum_32_characters

# ── Medusa Admin ──────────────────────────────────────────────────────────────
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_BACKEND_URL=http://localhost:9000
